{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naka-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naka-ai-db",
      "database_id": "c54b3e34-feab-4d93-af31-3354cc30fbe5"
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "naka-ai.com", "custom_domain": true },
    { "pattern": "www.naka-ai.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
