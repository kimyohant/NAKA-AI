config_version=5

[application]
config/name="Naka Seller Flow"
run/main_scene="res://flow.tscn"

[display]
window/size/viewport_width=900
window/size/viewport_height=560
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.082, 0.185, 1)

[audio]
driver/enable_input=false
