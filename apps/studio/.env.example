# Docker 部署环境变量（复制为 .env 后修改）
# Watchtower HTTP API 令牌，app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
NAKA_VERSION=dev

# Required by Docker deployment. Use a unique password; the browser prompts for HTTP Basic auth.
NAKA_AUTH_USER=admin
NAKA_AUTH_PASSWORD=

# Back-office /admin sign-in (system settings: AI keys, models, styles, agents). ≥ 16 chars,
# e.g. `openssl rand -hex 24`. Required by docker-compose.yml.
ADMIN_TOKEN=
