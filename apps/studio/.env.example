# Studio container settings for the ROOT docker-compose.yml (service `studio`).
# Copy to apps/studio/.env.production (git-ignored) and fill in. DATABASE_URL comes from the root
# compose file (STUDIO_DB_PASSWORD in the root .env) — do not set it here.

# Version shown in the app (set when you build a release, e.g. 1.2.0)
NAKA_VERSION=dev

# Sign-in: either naka-ai.com SSO (members) …
# NAKA_SSO_URL=https://naka-ai.com
# NAKA_SSO_SECRET=
# … or HTTP Basic auth (single user). One of the two is required.
NAKA_AUTH_USER=admin
NAKA_AUTH_PASSWORD=

# Back-office /admin sign-in (system settings: AI keys, models, styles, agents). ≥ 16 chars,
# e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=

# Public address of this studio (Seedance needs it to fetch local reference files)
# PUBLIC_BASE_URL=https://studio.naka-ai.com
