PORT=5679

# Optional. PostgreSQL (docs/adr/0004 — schema `studio` of the shared database, role studio_app).
#   postgres://studio_app:<STUDIO_DB_PASSWORD>@127.0.0.1:5432/naka   the root docker-compose postgres
#   pglite://memory                                                    in-process, gone on exit (tests)
#   pglite:///abs/dir                                                  in-process, kept on disk
# Unset → pglite in data/pglite (local dev without Docker). Migrations: backend/migrations/pg, applied at startup.
# DATABASE_URL=postgres://studio_app:change-me@127.0.0.1:5432/naka

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios/files to an upstream video API (local
# /static paths are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. Social Auto Reply (Facebook). Meta developer app credentials, server
# deployment only. Needs PUBLIC_BASE_URL for the OAuth callback
# (PUBLIC_BASE_URL + /api/v1/social/oauth/facebook/callback).
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
