{
  "name": "naka-ai",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "wrangler dev -c wrangler.dev.jsonc --ip 127.0.0.1 --port 8788",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.cjs src/auth/tests/*.test.cjs src/social/tests/*.test.cjs src/inbox/tests/*.test.cjs",
    "test:auth": "node --test src/auth/tests/*.test.cjs",
    "auth:setup": "node src/auth/setup-local.cjs",
    "dev:auth": "wrangler dev --ip 127.0.0.1 --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply naka-ai-db --local -c wrangler.dev.jsonc",
    "typecheck": "tsc -p .",
    "world:postprocess": "node creative/postprocess-world.cjs",
    "db:local": "wrangler d1 execute naka-ai-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute naka-ai-db --remote --file=schema.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "postgres": "^3.4.9",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@electric-sql/pglite": "^0.3.16",
    "typescript": "^7.0.2",
    "wrangler": "^4.137.0"
  },
  "private": true
}
