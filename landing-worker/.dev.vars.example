ANTHROPIC_API_KEY=sk-ant-...
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...
ADMIN_TOKEN=เปลี่ยนเป็นรหัสยาวๆ

# Run npm run auth:setup to generate a local SESSION_SECRET without printing it.
APP_ORIGIN=http://127.0.0.1:8788
# SESSION_SECRET is generated by npm run auth:setup; do not use a placeholder.
SMS_PROVIDER=mock
# Real SMS: set SMS_PROVIDER=thaibulksms and provide your approved sender.
