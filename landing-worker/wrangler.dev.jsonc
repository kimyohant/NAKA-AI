{
  // Local development only (npm run dev). Same as wrangler.jsonc minus the custom-domain
  // routes, which make wrangler dev rewrite every request to https://naka-ai.com and
  // break the auth origin check. Keep bindings in sync with wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naka-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../naka-ai-landing/public", // pages live in kimyohant/naka-ai-landing (checked out next to naka-ai-backend)
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naka-ai-db",
      "database_id": "c54b3e34-feab-4d93-af31-3354cc30fbe5"
    }
  ],
  // Private bucket for clips waiting to be posted (src/social). Create with: wrangler r2 bucket create naka-ai-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "naka-ai-media" }],
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "observability": { "enabled": true }
}
