# Copy to .env (git-ignored) and replace every value. Used by docker-compose.yml at the repo root.

# Superuser — migrations of the reporting schema and admin work only; apps never use it
POSTGRES_USER=naka_admin
POSTGRES_PASSWORD=change-me-admin

# One login per app (docs/adr/0004): each can only write its own schema
ACCOUNT_DB_PASSWORD=change-me-account
STUDIO_DB_PASSWORD=change-me-studio
REPORTING_DB_PASSWORD=change-me-reporting

# Connection strings the apps will use (Phase 1 / 2):
#   landing: postgres://account_app:<ACCOUNT_DB_PASSWORD>@postgres:5432/naka
#   studio:  postgres://studio_app:<STUDIO_DB_PASSWORD>@postgres:5432/naka
